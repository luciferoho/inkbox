{
  "name": "inkbox",
  "productName": "Inkbox",
  "version": "1.0.5",
  "description": "墨匣 Inkbox — 墨匣纸面 Markdown 编辑器 (Electron + Vue)",
  "main": "out/main/index.js",
  "author": "Lucifer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luciferoho/inkbox.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icons": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "bigfile": "node scripts/make-bigfile.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/plugin-listener": "^7.22.2",
    "@milkdown/vue": "^7.22.2",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.0.0",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "^26.6.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
